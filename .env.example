# Edge AI Digital Twin - Environment Configuration Template
# Duplicate as .env and modify with local deployment variables

# Cloud FastAPI & Dashboard Config
HOST=0.0.0.0
PORT=8000
DEVICE=auto

# ESP32-S3 Hardware Target
ESP32_COM_PORT=COM7
ESP32_BAUD_RATE=115200

# Wi-Fi Credentials for Edge Offload Transmission
WIFI_SSID=DEMO_WIFI
WIFI_PASSWORD=DEMO_PASSWORD
CLOUD_OFFLOAD_URL=http://127.0.0.1:8000/offload
